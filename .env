# Copy this file to .env in the same directory as docker-compose.yml.
# Docker Compose automatically loads .env — you don't need to source it
# or pass --env-file manually as long as it's named exactly ".env".
#
# .env is gitignored — never commit real values, this file (.env.example)
# is the only one that should be checked into the repo.

# How long (ms) the orchestrator waits for a storage node to answer a
# health-check ping before calling it unreachable.
PING_TIMEOUT_MS=200

# Consecutive missed health checks (each check is 5s apart) before a
# storage node's shards get auto-rerouted to its backup.
# 3 = ~15s grace period, 5 = ~25s, 12 = ~60s, etc.
STORAGE_FAILOVER_STREAK=3

# Same idea, but for auto-promoting a raft standby when a main raft node
# goes unreachable.
RAFT_FAILOVER_STREAK=3

# 2Q cache size (entries) on each storage node. Applied to every
# node-*/backup-* service that reads CACHE_CAPACITY in docker-compose.yml.
# Raise this if a node has more RAM to spare.
CACHE_CAPACITY=500
